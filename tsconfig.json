{
  // Simplified root tsconfig for Vite React app (no project references -> avoids TS6305/TS6306 during `tsc` in build)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
    // NOTE: Removed custom typeRoots to prevent TS treating each folder inside src/types as a global type package (caused TS2688 for 'PanoramasConfig').
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}